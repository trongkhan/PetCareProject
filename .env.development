# Loaded automatically by `expo start` (Expo "development" mode).
# Points at LOCAL Supabase — run `make dev` in ../petcare-backend first.
#
# 127.0.0.1 works on the iOS Simulator (shares the Mac's loopback). For a
# physical device or the Android emulator it won't reach your Mac — override the
# URL in .env.development.local (gitignored). See .env.example for the values.
#
# The anon key below is the Supabase CLI's fixed LOCAL demo key — not a secret.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Finder web page (Vercel) the tag QR points to. Update after `vercel --prod`.
EXPO_PUBLIC_FINDER_BASE_URL=https://senly-finder.vercel.app
